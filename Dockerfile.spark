# Spark-based ETL Docker Image
FROM python:3.12-slim

# Install system dependencies and Java
RUN apt-get update && apt-get install -y \
    openjdk-21-jre-headless \
    curl \
    procps \
    && rm -rf /var/lib/apt/lists/*

# Set Java home (Java 21 works with Spark 3.5+)
ENV JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64

# Install uv for package management
RUN pip install --no-cache-dir uv

# Set working directory
WORKDIR /app

# Copy dependency files first for better layer caching
COPY pyproject.toml ./

# Install all dependencies from pyproject.toml
RUN uv pip install --system pyspark pyarrow pyiceberg

# Copy source code
COPY src/ ./src/

# Copy generated data
COPY data/ ./data/

# Set environment variables
ENV PYTHONPATH="/app"
ENV PYSPARK_PYTHON="python"
ENV SPARK_HOME="/usr/local/lib/python3.12/site-packages/pyspark"

# Expose Spark UI ports
EXPOSE 4040 4041

# Default command runs the Spark ETL
CMD ["python", "-m", "src.etl.spark_etl"]
