# Production Spark ETL Dockerfile for EKS with Pod Identity
# Extends official Spark 3.5.7 image with AWS S3 support
FROM docker.io/apache/spark:3.5.7-python3

USER root

# Install AWS JARs compatible with EKS Pod Identity
# - Hadoop AWS 3.3.4: Matches Spark 3.5.x built-in Hadoop version
# - AWS SDK 1.12.770: Fully supports EKS Pod Identity (no IP restrictions)
RUN curl -fsSL https://repo1.maven.org/maven2/org/apache/hadoop/hadoop-aws/3.3.4/hadoop-aws-3.3.4.jar \
         -o /opt/spark/jars/hadoop-aws-3.3.4.jar && \
    curl -fsSL https://repo1.maven.org/maven2/com/amazonaws/aws-java-sdk-bundle/1.12.770/aws-java-sdk-bundle-1.12.770.jar \
         -o /opt/spark/jars/aws-java-sdk-bundle-1.12.770.jar

# Copy ETL application
# COPY --chown=spark:spark src/etl/spark_etl_nyc_taxi_k8s.py /opt/spark/work-dir/
COPY --chown=spark:spark src/etl/spark_etl_tpch.py /opt/spark/work-dir/

USER 185
WORKDIR /opt/spark/work-dir
