# TPC-H Benchmark Environment Configuration
# Copy this to .env and modify as needed

# ============================================================================
# AWS Configuration
# ============================================================================

# AWS Credentials (optional if using IAM roles)
# AWS_ACCESS_KEY_ID=your_access_key_id
# AWS_SECRET_ACCESS_KEY=your_secret_access_key
# AWS_SESSION_TOKEN=your_session_token  # Optional for temporary credentials
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# ============================================================================
# S3 Configuration
# ============================================================================

# S3 bucket for TPC-H data and results
S3_BUCKET_NAME=your-tpch-benchmark-bucket

# S3 prefixes for different data types
S3_TPCH_DATA_PREFIX=tpch-data
S3_RESULTS_PREFIX=results
S3_METRICS_PREFIX=metrics

# ============================================================================
# EKS Configuration (for PySpark jobs)
# ============================================================================

# EKS cluster name
EKS_CLUSTER_NAME=your-eks-cluster-name

# Kubernetes namespace for Spark jobs
K8S_NAMESPACE=default

# Spark Operator configuration
SPARK_OPERATOR_NAMESPACE=spark-operator

# ============================================================================
# AWS Batch Configuration (for Polars/DuckDB jobs)
# ============================================================================

# AWS Batch job queue name
BATCH_JOB_QUEUE=your-batch-job-queue

# AWS Batch job definition name
BATCH_JOB_DEFINITION=your-batch-job-definition

# Batch compute environment
BATCH_COMPUTE_ENVIRONMENT=your-compute-environment

# ============================================================================
# TPC-H Benchmark Configuration
# ============================================================================

# TPC-H scale factor (10 = ~10GB, 100 = ~100GB)
TPCH_SCALE_FACTOR=10

# Number of concurrent jobs to run for stress testing
CONCURRENT_JOBS_COUNT=10

# ============================================================================
# Performance Monitoring Configuration
# ============================================================================

# CloudWatch Logs configuration
CLOUDWATCH_LOG_GROUP=/aws/batch/tpch-benchmark
CLOUDWATCH_LOG_STREAM_PREFIX=tpch

# Metrics collection interval (seconds)
METRICS_COLLECTION_INTERVAL=5

# ============================================================================
# Application Configuration
# ============================================================================

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Enable debug logging (true/false)
DEBUG=false

# Enable verbose output
VERBOSE=false

# ============================================================================
# Cost Analysis Configuration
# ============================================================================

# AWS pricing (override if using different regions or pricing models)
# EKS pricing
EKS_CONTROL_PLANE_HOURLY=0.10
EKS_NODE_VCPU_HOURLY=0.0416

# Batch Fargate pricing
BATCH_FARGATE_VCPU_HOURLY=0.04048
BATCH_FARGATE_MEMORY_GB_HOURLY=0.004445

# S3 pricing
S3_REQUEST_PER_1000=0.0004
S3_STORAGE_GB_MONTHLY=0.023

# ============================================================================
# Job Configuration
# ============================================================================

# Spark job configuration
SPARK_EXECUTOR_COUNT=2
SPARK_EXECUTOR_CORES=2
SPARK_EXECUTOR_MEMORY=4g
SPARK_DRIVER_MEMORY=2g

# Polars/DuckDB job configuration
POLARS_VCPU_COUNT=4
POLARS_MEMORY_GB=16

# ============================================================================
# Data Generation Configuration
# ============================================================================

# Temporary directory for data generation
TEMP_DIR=/tmp/tpch-generation

# Parquet compression codec (snappy, zstd, gzip)
PARQUET_COMPRESSION=snappy

# Enable partitioning for lineitem table
ENABLE_LINEITEM_PARTITIONING=true

# ============================================================================
# Orchestration Configuration
# ============================================================================

# Job polling interval (seconds)
JOB_POLL_INTERVAL=5

# Maximum job wait time (seconds)
MAX_JOB_WAIT_TIME=3600

# Retry configuration
MAX_RETRIES=3
RETRY_DELAY_SECONDS=5

# ============================================================================
# Report Generation Configuration
# ============================================================================

# Output directory for reports
REPORTS_OUTPUT_DIR=./reports

# Report format (markdown, html, json)
REPORT_FORMAT=markdown

# Include cost analysis in reports
INCLUDE_COST_ANALYSIS=true

# Include startup latency analysis
INCLUDE_STARTUP_LATENCY=true
