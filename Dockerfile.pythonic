# Pythonic ETL Docker Image for NYC Taxi Benchmark (Polars + DuckDB + PyIceberg)
# Force AMD64 architecture for compatibility with AWS EC2/EKS
FROM --platform=linux/amd64 python:3.12-slim

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Install minimal system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install uv for fast package management
RUN pip install --no-cache-dir uv

# Set working directory
WORKDIR /app

# Copy dependency files first for better layer caching
COPY pyproject.toml ./

# Install all dependencies including S3 access libraries
# Install in a single layer to reduce image size
RUN uv pip install --system --no-cache \
    polars \
    pyarrow \
    pyiceberg \
    duckdb \
    boto3 \
    s3fs \
    fsspec \
    psutil \
    python-json-logger \
    fastparquet

# Copy source code (includes NYC Taxi ETL scripts)
COPY src/ ./src/

# Create output directory
RUN mkdir -p /app/output

# Set environment variables
ENV PYTHONPATH="/app"
# Configure AWS region (can be overridden at runtime)
ENV AWS_DEFAULT_REGION="eu-central-1"

# Default command runs the NYC Taxi Polars ETL
CMD ["python", "-m", "src.etl.polars_etl_nyc_taxi", "--size", "tiny"]
