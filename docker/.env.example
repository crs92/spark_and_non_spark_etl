# Docker Environment Configuration
# Copy this to .env and modify as needed

# MinIO Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=http://minio:9000

# PostgreSQL Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=iceberg_catalog
POSTGRES_USER=iceberg
POSTGRES_PASSWORD=iceberg123

# Spark Configuration
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g

# Iceberg Configuration
ICEBERG_CATALOG_URI=postgresql://iceberg:iceberg123@postgres:5432/iceberg_catalog
ICEBERG_WAREHOUSE_PATH=s3a://iceberg-warehouse/

# Application Configuration
ETL_INPUT_PATH=/app/data/input
ETL_OUTPUT_PATH=/app/data/output
LOG_LEVEL=INFO
